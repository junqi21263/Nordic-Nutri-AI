# HTTPS endpoint of get-login-ticket (no trailing slash)
API_BASE_URL=https://your-env.service.tcloudbase.com/get-login-ticket
# Required only for state-changing suites, which refuse any value other than sandbox.
TEST_ENV_CONFIRMATION=sandbox
ALLOW_PERSISTENT_WRITES=0
# Short-lived product sessions for two dedicated test accounts. Never commit values.
TEST_PRODUCT_TOKEN_A=
TEST_PRODUCT_TOKEN_B=
TEST_RUN_ID=

# Usage (tokens must be injected by CI/terminal; never paste them into reports):
# API_BASE_URL=... TEST_PRODUCT_TOKEN_A=... TEST_PRODUCT_TOKEN_B=... \
# node scripts/api-integrity/run-authenticated-readonly.mjs
