# Mini Program build configuration. No database or provider secret belongs here.
TARO_APP_ENV=development
TARO_APP_ENABLE_REAL_AUTH=true
# Formal HTTPS CDN root for milestone illustrations (do not append /milestones here).
# Copy this file to the repository-root .env.development or .env.production.
TARO_APP_MILESTONE_ASSET_CDN=https://lewis-healthy-d4glgqqzv73a5bc10-1420560890.tcloudbaseapp.com

# CloudBase function environment variables (configure in the function console).
# Keep real values out of source control.
WX_APPID=
WX_SECRET=
TCB_ENV=
IDENTITY_HASH_PEPPER=
CLOUDBASE_APIKEY=
APP_SESSION_SECRET=
# Optional admin console password login (food-images hosting UI).
# Configure only in the CloudBase function environment, never in the mini program.
ADMIN_CONSOLE_USERNAME=
ADMIN_CONSOLE_PASSWORD=

# Optional server-side AI providers.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
VITA_API_KEY=
VITA_MODEL=vita-video-3.0
# Qwen3-VL food-image recognition (configure only in the CloudBase function).
QWEN_API_KEY=
# Alias accepted for DashScope deployments (set one of the two keys).
DASHSCOPE_API_KEY=
QWEN_WORKSPACE_ID=llm-ekun6ter25w7d0ms
QWEN_VL_FLASH_MODEL=qwen3-vl-flash
QWEN_VL_PLUS_MODEL=qwen3-vl-plus

# Unified food catalog backend (USDA + Open Food Facts + image pipeline).
USDA_FDC_API_KEY=
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1
OPEN_FOOD_FACTS_BASE_URL=https://world.openfoodfacts.org
OPEN_FOOD_FACTS_USER_AGENT=NordicNutriAI/1.0
FOOD_IMAGE_ALLOWED_HOSTS=images.openfoodfacts.org,world.openfoodfacts.org,static.openfoodfacts.org,images-us.openfoodfacts.org
FOOD_IMAGE_MAX_BYTES=10485760
FOOD_IMAGE_STORAGE_BUCKET=food-images
# Stable HTTPS CDN base for food image display; leave blank only for local tests.
FOOD_IMAGE_CDN_BASE_URL=
FOOD_SEARCH_CACHE_TTL_SECONDS=300
FOOD_BARCODE_CACHE_TTL_SECONDS=86400

# Hunyuan food-image generation (小程序成长计划 / CloudBase AI).
# Model ID source: CloudBase docs — HY-Image-3.0-Plus-4090-Tob-v1.0
# https://docs.cloudbase.net/ai/image-model/overview
# https://docs.cloudbase.net/ai/ai-inspire-plan
# Official sizes only: 1024x1024 | 1280x720 | 720x1280 | 1280x1280
# (1024x768 is achieved via sharp crop after generation.)
HY_IMAGE_MODEL=HY-Image-3.0-Plus-4090-Tob-v1.0
HY_IMAGE_CANDIDATE_COUNT=1
HY_IMAGE_WIDTH=1280
HY_IMAGE_HEIGHT=720
HY_IMAGE_SIZE=1280x720
HY_IMAGE_MAX_RETRIES=3
HY_IMAGE_CONCURRENCY=2
HY_IMAGE_DAILY_LIMIT=500
FOOD_IMAGE_STORAGE_PREFIX=food-library
FOOD_IMAGE_GENERATION_ENABLED=true
# Optional: delegate only Hunyuan image generation to an isolated CloudBase worker.
# These two values belong only in the existing main function environment, never in the mini program.
# HY_IMAGE_WORKER_ENDPOINT=https://<worker-env-id>.service.tcloudbase.com/hunyuan-image-worker/generate
# AI_WORKER_SHARED_SECRET=
# HTTP 云函数已配置 CLOUDBASE_APIKEY（RDB 必需）。AI 生图会刻意避开该 key，
# 改用 SCF 注入的 TENCENTCLOUD_SECRETID/SECRETKEY（无下划线，系统自动注入，勿手改）。
# 仅当 ambient 密钥缺失时，才手动配置永久密钥（有下划线）：
# TENCENTCLOUD_SECRET_ID=
# TENCENTCLOUD_SECRET_KEY=
# TENCENTCLOUD_REGION=ap-shanghai
# HY_IMAGE_REQUEST_TIMEOUT_MS=300000
