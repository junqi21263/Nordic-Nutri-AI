{
  "envId": "lewis-healthy-d4glgqqzv73a5bc10",
  "functionRoot": "cloudbase/functions",
  "functions": [
    {
      "name": "get-login-ticket",
      "type": "HTTP",
      "timeout": 900,
      "runtime": "Nodejs18.15",
      "installDependency": true,
      "ignore": ["*.test.mjs", "node_modules/**", ".git/**"]
    },
    {
      "name": "nordic-api",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "ignore": ["*.test.mjs", "node_modules/**", ".git/**"]
    },
    {
      "name": "food-image-batch-dispatcher",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false,
      "triggers": [{"name":"food-image-batch-dispatch-every-minute","type":"timer","config":"0 * * * * * *"}],
      "ignore": ["*.test.mjs", "node_modules/**", ".git/**"]
    },
    {
      "name": "vision-image-purge-dispatcher",
      "timeout": 60,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": false,
      "triggers": [{"name":"vision-image-purge-daily","type":"timer","config":"0 0 3 * * * *"}],
      "ignore": ["*.test.mjs", "node_modules/**", ".git/**"]
    },
    {
      "name": "vision-analysis-dispatcher",
      "type": "Event",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "triggers": [{"name":"vision-analysis-dispatcher-every-5-seconds","type":"timer","config":"*/5 * * * * * *"}],
      "ignore": ["*.test.mjs", ".git/**"]
    },
    {
      "name": "vision-analysis-worker",
      "type": "Event",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": true,
      "ignore": ["*.test.mjs", ".git/**"]
    },
    {
      "name": "vision-analysis-reaper",
      "type": "Event",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false,
      "triggers": [{"name":"vision-analysis-reaper-every-minute","type":"timer","config":"0 * * * * * *"}],
      "ignore": ["*.test.mjs", ".git/**"]
    },
    {
      "name": "push-reminder-dispatcher",
      "type": "Event",
      "timeout": 60,
      "runtime": "Nodejs18.15",
      "handler": "index.main",
      "installDependency": false,
      "triggers": [{"name":"push-reminder-dispatcher-every-minute","type":"timer","config":"0 * * * * * *"}],
      "ignore": ["*.test.mjs", ".git/**"]
    },
    {
      "name": "analytics-dispatcher",
      "type": "Event",
      "timeout": 60,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "installDependency": false,
      "triggers": [
        {
          "name": "analytics-every-five-minutes",
          "type": "timer",
          "config": "0 */5 * * * * *"
        }
      ],
      "ignore": [
        "*.test.mjs",
        ".git/**"
      ]
    }
  ]
}
